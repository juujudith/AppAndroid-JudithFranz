<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de ayuda -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_degradado"
    tools:context=".AyudaActivity">

    <!-- Volver + título -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        style="@style/BarraSuperior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/ayuda_titulo" />

    <!-- Contenido (scroll) -->
    <ScrollView
        android:id="@+id/scrollAyuda"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnEntendido"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/espacio_xxl"
            android:paddingBottom="@dimen/espacio_l">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxWidth="@dimen/ancho_logo_ayuda"
                android:maxHeight="@dimen/alto_logo_ayuda"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/logo_desc"
                android:src="@drawable/mlp_logo" />

            <TextView
                style="@style/TextoCuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/espacio_l"
                android:gravity="center"
                android:text="@string/ayuda_intro" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_l"
                app:cardBackgroundColor="?attr/temaSuperficie"
                app:cardCornerRadius="@dimen/radio_tarjeta_ayuda"
                app:cardElevation="@dimen/elevacion_tarjeta"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_xl">

                    <ImageView
                        android:layout_width="@dimen/icono_paso_ayuda"
                        android:layout_height="@dimen/icono_paso_ayuda"
                        android:layout_marginEnd="@dimen/espacio_l"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSeccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso1_titulo" />

                        <TextView
                            style="@style/TextoCuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso1_texto" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_l"
                app:cardBackgroundColor="?attr/temaSuperficie"
                app:cardCornerRadius="@dimen/radio_tarjeta_ayuda"
                app:cardElevation="@dimen/elevacion_tarjeta"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_xl">

                    <ImageView
                        android:layout_width="@dimen/icono_paso_ayuda"
                        android:layout_height="@dimen/icono_paso_ayuda"
                        android:layout_marginEnd="@dimen/espacio_l"
                        android:importantForAccessibility="no"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="?attr/temaTexto" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSeccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso2_titulo" />

                        <TextView
                            style="@style/TextoCuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso2_texto" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_l"
                app:cardBackgroundColor="?attr/temaSuperficie"
                app:cardCornerRadius="@dimen/radio_tarjeta_ayuda"
                app:cardElevation="@dimen/elevacion_tarjeta"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_xl">

                    <ImageView
                        android:layout_width="@dimen/icono_paso_ayuda"
                        android:layout_height="@dimen/icono_paso_ayuda"
                        android:layout_marginEnd="@dimen/espacio_l"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_scan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSeccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso3_titulo" />

                        <TextView
                            style="@style/TextoCuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso3_texto" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_l"
                app:cardBackgroundColor="?attr/temaSuperficie"
                app:cardCornerRadius="@dimen/radio_tarjeta_ayuda"
                app:cardElevation="@dimen/elevacion_tarjeta"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_xl">

                    <ImageView
                        android:layout_width="@dimen/icono_paso_ayuda"
                        android:layout_height="@dimen/icono_paso_ayuda"
                        android:layout_marginEnd="@dimen/espacio_l"
                        android:importantForAccessibility="no"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="?attr/temaTexto" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSeccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso4_titulo" />

                        <TextView
                            style="@style/TextoCuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso4_texto" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/temaSuperficie"
                app:cardCornerRadius="@dimen/radio_tarjeta_ayuda"
                app:cardElevation="@dimen/elevacion_tarjeta"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_xl">

                    <ImageView
                        android:layout_width="@dimen/icono_paso_ayuda"
                        android:layout_height="@dimen/icono_paso_ayuda"
                        android:layout_marginEnd="@dimen/espacio_l"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSeccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso5_titulo" />

                        <TextView
                            style="@style/TextoCuerpo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_paso5_texto" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Botón Entendido -->
    <Button
        android:id="@+id/btnEntendido"
        style="@style/BotonPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/ancho_boton_destacado"
        android:layout_marginBottom="@dimen/espacio_xxxl"
        android:text="@string/btn_entendido"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
