<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_degradado"
    tools:context=".CardActivity">

    <!-- ================= CABECERA CON BOTÓN VOLVER ================= -->
    <!-- Cabecera + botón volver -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnVolverHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_filtro_input"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/azulnoche"
            android:contentDescription="@string/desc_volver" />

        <TextView
            android:id="@+id/tvCardScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="48dp"
            android:gravity="center"
            android:fontFamily="@font/nunito_extralight"
            android:text="@string/detalle_titulo"
            android:textColor="@color/azulnoche"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ================= CONTENIDO SCROLLABLE DE LA FICHA ================= -->
    <!-- Información de la carta -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- ILUSTRACIÓN DESTACADA DE LA CARTA (Con recorte limpio de esquinas) -->
            <!-- Imagen de la carta -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewImagen"
                android:layout_width="220dp"
                android:layout_height="308dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/transparent">

                <ImageView
                    android:id="@+id/ivDetalleCarta"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:scaleX="1.05"
                    android:scaleY="1.05"
                    android:src="@drawable/carta_placeholder"
                    android:contentDescription="@string/desc_imagen_carta_ejemplo" />
            </androidx.cardview.widget.CardView>

            <!-- CUADRO TRANSLÚCIDO CON LA INFORMACIÓN TÉCNICA Y ACCIONES -->
            <LinearLayout
                android:id="@+id/cuadroInfoCarta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_cuadro_cartas"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:gravity="center_horizontal">

                <!-- Nombre de la carta (Name) -->
                <!-- Nombre de la carta -->
                <TextView
                    android:id="@+id/tvDetalleNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/nunito_extralight"
                    android:text="@string/ejemplo_nombre"
                    android:textColor="@color/azulnoche"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Píldora de Rareza / Tier en alto contraste (Accesibilidad) -->
                <!-- Rareza -->
                <TextView
                    android:id="@+id/tvDetalleRareza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_boton_morado"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="5dp"
                    android:fontFamily="@font/nunito_extralight"
                    android:text="@string/ejemplo_rareza_detalle"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:contentDescription="@string/ejemplo_rareza_detalle" />

                <!-- Línea divisoria sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#337E788C" />

                <!-- Fila de Código (Code) -->
                <!-- Código -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="@string/etiqueta_codigo"
                        android:textColor="@color/gris_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetalleCodigo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="@string/ejemplo_codigo"
                        android:textColor="@color/azulnoche"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Fila de Edición (Edition) -->
                <!-- Edición -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="@string/etiqueta_edicion"
                        android:textColor="@color/gris_texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetalleEdicion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="@string/ejemplo_edicion"
                        android:textColor="@color/azulnoche"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Línea divisoria sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#337E788C" />

                <!-- Interruptor para marcar posesión (Owned / Unowned) -->
                <!-- Marcar que tenemos la carta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_filtro_input"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEstadoPosesion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="@string/estado_en_coleccion"
                        android:textColor="@color/verde_ok"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchTengoCarta"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="true"
                        android:contentDescription="@string/desc_switch_tengo" />
                </LinearLayout>

                <!-- Contador de cartas repetidas (Para eventos de intercambio) -->
                <!-- Contador de cartas repetidas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="@string/etiqueta_cantidad"
                        android:textColor="@color/azulnoche"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnRestarRepetida"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_filtro_input"
                        android:src="@android:drawable/ic_media_previous"
                        app:tint="@color/azulnoche"
                        android:contentDescription="@string/desc_restar" />

                    <TextView
                        android:id="@+id/tvCantidadCarta"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="1"
                        tools:ignore="HardcodedText"
                        android:textColor="@color/azulnoche"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnSumarRepetida"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_filtro_input"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/azulnoche"
                        android:contentDescription="@string/desc_sumar" />
                </LinearLayout>

                <!-- Botones de gestión: Modificar y Borrar -->
                <!-- Botones modificar y borrar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnModificarCarta"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_boton_morado"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="@string/btn_modificar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnBorrarCarta"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_boton_borrar"
                        android:fontFamily="@font/nunito_extralight"
                        android:text="@string/btn_borrar"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ================= BARRA INFERIOR FIJA ================= -->
    <!-- Incluir barra inferior -->
    <include layout="@layout/fragment_bottom_bar" />

</LinearLayout>