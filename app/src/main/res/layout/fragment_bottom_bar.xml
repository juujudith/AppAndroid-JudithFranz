<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta flotante con esquinas redondeadas -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margen_barra_inferior"
    app:cardBackgroundColor="?attr/temaSuperficie"
    app:cardCornerRadius="@dimen/radio_barra_inferior"
    android:importantForAccessibility="no"
    app:cardElevation="@dimen/elevacion_alta"
    app:strokeWidth="0dp">

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:accessibilityPaneTitle="@string/desc_barra_inferior"
        android:importantForAccessibility="yes"
        android:minHeight="@dimen/objetivo_tactil_minimo"
        app:elevation="0dp"
        app:menu="@menu/menu_bottom"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="@dimen/icono_barra_inferior"
        app:itemIconTint="@color/nav_item_color" />

</com.google.android.material.card.MaterialCardView>
