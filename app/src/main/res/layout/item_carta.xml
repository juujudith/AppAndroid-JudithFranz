<?xml version="1.0" encoding="utf-8"?>
<!-- Cartas individuales -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/temaTarjeta"
    app:cardCornerRadius="@dimen/radio_tarjeta"
    app:cardElevation="@dimen/elevacion_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_m">

        <ImageView
            android:id="@+id/ivItemCarta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_imagen_carta_lista"
            android:contentDescription="@string/desc_imagen_carta_ejemplo"
            android:scaleType="centerCrop"
            android:src="@drawable/carta_placeholder" />

        <TextView
            android:id="@+id/tvItemNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/ejemplo_nombre"
            android:textColor="?attr/temaTexto"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/ejemplo_codigo"
            android:textColor="?attr/temaTextoSecundario"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemRareza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/temaAcento"
                android:paddingHorizontal="@dimen/espacio_s"
                android:paddingVertical="@dimen/espacio_xxs"
                android:text="@string/ejemplo_rareza"
                android:textColor="?attr/temaTextoSobreAcento"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemEstado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/estado_tengo"
                android:textColor="?attr/temaOk"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
