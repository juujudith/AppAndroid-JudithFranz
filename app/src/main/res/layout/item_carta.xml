<?xml version="1.0" encoding="utf-8"?>
<!-- Cartas individuales -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#F8F5FF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    tools:layout_width="180dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivItemCarta"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:contentDescription="@string/desc_imagen_carta_ejemplo"
            android:scaleType="centerCrop"
            android:src="@drawable/carta_twilight_sc001" />

        <TextView
            android:id="@+id/tvItemNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_extralight"
            android:maxLines="1"
            android:text="@string/ejemplo_nombre"
            android:textColor="@color/azulnoche"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extralight"
            android:text="@string/ejemplo_codigo"
            android:textColor="@color/gris_texto"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemRareza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/pildora_rareza"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/ejemplo_rareza"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemEstado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/estado_tengo"
                android:textColor="@color/verde_ok"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>