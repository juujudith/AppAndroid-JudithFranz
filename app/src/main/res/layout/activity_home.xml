<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_degradado">

    <!-- CUADRO CENTRAL -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        style="@style/BarraSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_home"
        app:title="@string/home_titulo"
        app:titleCentered="false" />

    <!-- CUADRO CENTRAL (CONTIENE FILTROS ARRIBA + CARTAS CON SCROLL ABAJO) -->
    <!-- Filtros -->
    <LinearLayout
        android:id="@+id/cuadroContenedorCartas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/espacio_xl"
        android:layout_marginTop="@dimen/espacio_l"
        android:layout_marginBottom="@dimen/espacio_m"
        android:background="@drawable/bg_cuadro_cartas"
        android:elevation="@dimen/elevacion_cuadro"
        android:orientation="vertical"
        android:padding="@dimen/espacio_l">

        <!-- ================= APARTADO SUPERIOR DE FILTROS ================= -->
        <LinearLayout
            android:id="@+id/layoutFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/espacio_ml">

            <!-- Fila 1: Buscador por Código o Nombre -->
            <!-- Buscador por código o nombre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <EditText
                android:id="@+id/etFiltroCodigo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/objetivo_tactil_minimo"
                android:background="@drawable/bg_filtro_input"
                android:fontFamily="sans-serif"
                android:hint="@string/hint_buscar"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="@dimen/espacio_lx"
                android:textColor="?attr/temaTexto"
                android:textColorHint="?attr/temaTextoSecundario"
                android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnBuscarFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:minWidth="@dimen/objetivo_tactil_minimo"
                    android:minHeight="@dimen/objetivo_tactil_minimo"
                    android:background="@drawable/bg_filtro_input"
                    android:contentDescription="@string/desc_buscar"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="?attr/temaTexto" />
            </LinearLayout>

            <!-- Fila 2: Desplegables de Rareza/Tier y Posesión (Tengo / No tengo) -->
            <!-- Desplegables de rareza y posesión -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:orientation="horizontal">

                <!-- Filtro por Rareza / Tier -->
                <!-- Filtro por posesión -->
                <Spinner
                    android:id="@+id/spinnerFiltroRareza"
                    android:entries="@array/filtro_rareza"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/objetivo_tactil_minimo"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/espacio_xs"
                    android:background="@drawable/bg_filtro_input"
                    android:paddingHorizontal="@dimen/espacio_m"
                    android:contentDescription="@string/desc_filtro_rareza" />

                <!-- Filtro por Posesión (Las tengo / Me faltan) -->
                <Spinner
                    android:id="@+id/spinnerFiltroTengo"
                    android:entries="@array/filtro_tengo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/objetivo_tactil_minimo"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:background="@drawable/bg_filtro_input"
                    android:paddingHorizontal="@dimen/espacio_m"
                    android:contentDescription="@string/desc_filtro_tengo" />
            </LinearLayout>
        </LinearLayout>

        <!-- Línea divisoria sutil entre filtros y cartas -->
        <!-- Línea entre filtros y cartas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/grosor_divisor"
            android:layout_marginBottom="@dimen/espacio_m"
            android:background="?attr/temaDivisor" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- Cartas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCartas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="@integer/columnas_cartas"
            tools:itemCount="4"
            tools:listitem="@layout/item_carta" />

            <TextView
                android:id="@+id/tvHomeVacio"
                style="@style/TextoCuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:padding="@dimen/espacio_xl"
                android:text="@string/home_vacio"
                android:textColor="?attr/temaTexto"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- BARRA INFERIOR -->
    <!-- Incluir barra inferior -->
    <include
        android:id="@+id/bottomBar"
        layout="@layout/fragment_bottom_bar" />

</LinearLayout>