<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_degradado">

    <!-- CUADRO CENTRAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_extralight"
            android:gravity="center"
            android:text="@string/home_titulo"
            android:textColor="?attr/temaTexto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAnadirCarta"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_filtro_input"
            android:contentDescription="@string/desc_anadir_carta"
            android:src="@android:drawable/ic_input_add"
            app:tint="?attr/temaTexto" />
    </LinearLayout>

    <!-- CUADRO CENTRAL (CONTIENE FILTROS ARRIBA + CARTAS CON SCROLL ABAJO) -->
    <!-- Filtros -->
    <LinearLayout
        android:id="@+id/cuadroContenedorCartas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_cuadro_cartas"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ================= APARTADO SUPERIOR DE FILTROS ================= -->
        <LinearLayout
            android:id="@+id/layoutFiltros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <!-- Fila 1: Buscador por Código o Nombre -->
            <!-- Buscador por código o nombre -->
            <EditText
                android:id="@+id/etFiltroCodigo"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_filtro_input"
                android:drawableEnd="@android:drawable/ic_menu_search"
                android:drawableTint="?attr/temaTexto"
                android:fontFamily="@font/nunito_extralight"
                android:hint="@string/hint_buscar"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="?attr/temaTexto"
                android:textColorHint="?attr/temaTextoSecundario"
                android:textSize="13sp" />

            <!-- Fila 2: Desplegables de Rareza/Tier y Posesión (Tengo / No tengo) -->
            <!-- Desplegables de rareza y posesión -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Filtro por Rareza / Tier -->
                <!-- Filtro por posesión -->
                <Spinner
                    android:id="@+id/spinnerFiltroRareza"
                    android:entries="@array/filtro_rareza"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_filtro_input"
                    android:paddingHorizontal="8dp"
                    android:contentDescription="@string/desc_filtro_rareza" />

                <!-- Filtro por Posesión (Las tengo / Me faltan) -->
                <Spinner
                    android:id="@+id/spinnerFiltroTengo"
                    android:entries="@array/filtro_tengo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_filtro_input"
                    android:paddingHorizontal="8dp"
                    android:contentDescription="@string/desc_filtro_tengo" />
            </LinearLayout>
        </LinearLayout>

        <!-- Línea divisoria sutil entre filtros y cartas -->
        <!-- Línea entre filtros y cartas -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="?attr/temaDivisor" />

        <!-- Cartas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCartas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:itemCount="4"
            tools:listitem="@layout/item_carta" />

    </LinearLayout>

    <!-- BARRA INFERIOR -->
    <!-- Incluir barra inferior -->
    <include layout="@layout/fragment_bottom_bar" />

</LinearLayout>