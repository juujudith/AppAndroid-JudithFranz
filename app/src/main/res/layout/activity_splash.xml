<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_splash_background">

    <!-- Logo centrado (lo anima el código Kotlin) -->
    <ImageView
        android:id="@+id/ivLogoSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:maxWidth="@dimen/ancho_logo_splash"
        android:maxHeight="@dimen/alto_logo_splash"
        android:layout_gravity="center"
        android:contentDescription="@string/logo_desc"
        android:src="@drawable/mlp_logo" />

</FrameLayout>