<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/objetivo_tactil_minimo"
    app:cardBackgroundColor="?attr/temaTarjeta"
    app:cardCornerRadius="@dimen/radio_tarjeta"
    app:cardElevation="@dimen/elevacion_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_m"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/ivRepetidaImagen"
            android:layout_width="@dimen/miniatura_carta_ancho"
            android:layout_height="@dimen/miniatura_carta_alto"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/carta_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRepetidaNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="?attr/temaTexto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRepetidaCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="?attr/temaTextoSecundario"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRepetidaCantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:background="@drawable/bg_boton_morado"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="@dimen/espacio_l"
            android:paddingVertical="@dimen/espacio_xs"
            android:textColor="?attr/temaTextoSobrePrincipal"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
