<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_s"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/temaSuperficie"
    app:cardCornerRadius="@dimen/radio_tarjeta_tema"
    app:cardElevation="@dimen/elevacion_media"
    app:strokeColor="?attr/temaPrincipal"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_m">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radio_tarjeta"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_degradado"
                android:orientation="vertical"
                android:padding="@dimen/espacio_m">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_logo_preview_tema"
                    android:importantForAccessibility="no"
                    android:src="@drawable/mlp_logo" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_s"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alto_carta_preview_tema"
                        android:layout_marginEnd="@dimen/espacio_xs"
                        android:layout_weight="1"
                        android:background="@drawable/carta_placeholder" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alto_carta_preview_tema"
                        android:layout_marginStart="@dimen/espacio_xs"
                        android:layout_weight="1"
                        android:background="@drawable/carta_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_s"
                    android:background="@drawable/bg_cuadro_cartas"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_s">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif"
                        android:maxLines="2"
                        android:text="@string/tema_preview_carta"
                        android:textColor="?attr/temaTexto"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/temaAcento"
                        android:paddingHorizontal="@dimen/espacio_xs"
                        android:text="@string/tema_preview_rareza"
                        android:textColor="?attr/temaTextoSobreAcento"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_s"
                    android:background="@drawable/bg_boton_morado"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingVertical="@dimen/espacio_xxs_plus"
                    android:text="@string/btn_modificar"
                    android:textColor="?attr/temaTextoSobrePrincipal"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:background="@drawable/bg_barra_mini"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/espacio_xs">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/icono_preview_barra"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home"
                        app:tint="?attr/temaPrincipal" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/icono_preview_barra"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_scan"
                        app:tint="?attr/temaIconoBarra" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/icono_preview_barra"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings"
                        app:tint="?attr/temaIconoBarra" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTemaNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="@dimen/espacio_xs"
            android:text="@string/tema_luna"
            android:textColor="?attr/temaTexto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/espacio_xs">

            <TextView
                android:id="@+id/tvTemaModo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:text="@string/tema_claro"
                android:textColor="?attr/temaTextoSecundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTemaActualMarca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_boton_morado"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="@dimen/espacio_m"
                android:paddingVertical="@dimen/espacio_xxxs"
                android:text="@string/tema_en_uso"
                android:textColor="?attr/temaTextoSobrePrincipal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
