<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- LINEAR LAYOUT VERTICAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/espacio_xxxl"
        android:background="@drawable/fondo_degradado">

        <!-- LOGO -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="@dimen/ancho_logo_registro"
            android:maxHeight="@dimen/alto_logo_registro"
            android:contentDescription="@string/logo_desc"
            android:src="@drawable/mlp_logo" />

        <!-- TÍTULO DE REGISTRO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:fontFamily="sans-serif-medium"
            android:text="@string/registro_titulo"
            android:textColor="?attr/temaTexto"
            android:textColorHint="?attr/temaTexto"
            app:hintTextColor="?attr/temaTexto"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- NOMBRE -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombre"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="@dimen/ancho_formulario"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:textColor="?attr/temaTexto"
            android:textColorHint="?attr/temaTexto"
            app:hintTextColor="?attr/temaTexto"
            android:hint="@string/hint_nombre"
            app:boxBackgroundColor="?attr/temaSuperficie"
            app:boxCornerRadiusTopStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusTopEnd="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomEnd="@dimen/radio_tarjeta"
            app:boxStrokeColor="?attr/temaPrincipal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombre"
                android:autofillHints="username"
                android:importantForAutofill="yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="18sp"
                android:textColor="?attr/temaTexto"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CORREO ELECTRÓNICO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmailRegistro"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="@dimen/ancho_formulario"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:textColor="?attr/temaTexto"
            android:textColorHint="?attr/temaTexto"
            app:hintTextColor="?attr/temaTexto"
            android:hint="@string/hint_email"
            app:boxBackgroundColor="?attr/temaSuperficie"
            app:boxCornerRadiusTopStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusTopEnd="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomEnd="@dimen/radio_tarjeta"
            app:boxStrokeColor="?attr/temaPrincipal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmailRegistro"
                android:autofillHints="emailAddress"
                android:importantForAutofill="yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="18sp"
                android:textColor="?attr/temaTexto"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONTRASEÑA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPasswordRegistro"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="@dimen/ancho_formulario"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:textColor="?attr/temaTexto"
            android:textColorHint="?attr/temaTexto"
            app:hintTextColor="?attr/temaTexto"
            android:hint="@string/hint_password"
            app:endIconMode="password_toggle"
            app:boxBackgroundColor="?attr/temaSuperficie"
            app:boxCornerRadiusTopStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusTopEnd="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomEnd="@dimen/radio_tarjeta"
            app:boxStrokeColor="?attr/temaPrincipal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPasswordRegistro"
                android:autofillHints="newPassword"
                android:importantForAutofill="yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="18sp"
                android:textColor="?attr/temaTexto"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONFIRMAR CONTRASEÑA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmarPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="@dimen/ancho_formulario"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:textColor="?attr/temaTexto"
            android:textColorHint="?attr/temaTexto"
            app:hintTextColor="?attr/temaTexto"
            android:hint="@string/hint_confirmar_password"
            app:endIconMode="password_toggle"
            app:boxBackgroundColor="?attr/temaSuperficie"
            app:boxCornerRadiusTopStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusTopEnd="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomEnd="@dimen/radio_tarjeta"
            app:boxStrokeColor="?attr/temaPrincipal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmarPassword"
                android:autofillHints="newPassword"
                android:importantForAutofill="yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="18sp"
                android:textColor="?attr/temaTexto"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- REGISTRARSE -->
        <Button
            android:id="@+id/btnRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/ancho_boton_principal"
            android:minHeight="@dimen/alto_boton_principal"
            android:layout_marginTop="@dimen/espacio_xxxl"
            android:text="@string/btn_registro"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="?attr/temaPrincipal"
            android:textColor="?attr/temaTextoSobrePrincipal" />

        <!-- VOLVER AL LOGIN -->
        <TextView
            android:id="@+id/tvYaCuenta"
            android:minHeight="@dimen/objetivo_tactil_minimo"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:padding="@dimen/espacio_m"
            android:text="@string/txt_ya_cuenta"
            android:fontFamily="sans-serif"
            android:textColor="?attr/temaTexto"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>