<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- LINEAR LAYOUT VERTICAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/espacio_xxxl"
        android:background="@drawable/fondo_degradado">

        <!-- LOGO -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="@dimen/ancho_logo_login"
            android:maxHeight="@dimen/alto_logo_login"
            android:contentDescription="@string/logo_desc"
            android:src="@drawable/mlp_logo" />

        <!-- TÍTULO DE INICIAR SESIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:fontFamily="sans-serif-medium"
            android:text="@string/login_titulo"
            android:textColor="?attr/temaTexto"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- CORREO ELECTRÓNICO -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="@dimen/ancho_formulario"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_enorme"
            android:hint="@string/hint_email"
            android:textColor="?attr/temaTexto"
            android:textColorHint="?attr/temaTexto"
            app:hintTextColor="?attr/temaTexto"
            app:boxBackgroundColor="?attr/temaSuperficie"
            app:boxCornerRadiusTopStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusTopEnd="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomEnd="@dimen/radio_tarjeta"
            app:boxStrokeColor="?attr/temaPrincipal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:autofillHints="emailAddress"
                android:importantForAutofill="yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="18sp"
                android:textColor="?attr/temaTexto"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONTRASEÑA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="@dimen/ancho_formulario"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:hint="@string/hint_password"
            android:textColor="?attr/temaTexto"
            android:textColorHint="?attr/temaTexto"
            app:hintTextColor="?attr/temaTexto"
            app:endIconMode="password_toggle"
            app:boxBackgroundColor="?attr/temaSuperficie"
            app:boxCornerRadiusTopStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusTopEnd="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomStart="@dimen/radio_tarjeta"
            app:boxCornerRadiusBottomEnd="@dimen/radio_tarjeta"
            app:boxStrokeColor="?attr/temaPrincipal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:autofillHints="password"
                android:importantForAutofill="yes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textSize="18sp"
                android:textColor="?attr/temaTexto"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ENTRAR (LOGIN) -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/ancho_boton_principal"
            android:minHeight="@dimen/alto_boton_principal"
            android:layout_marginTop="@dimen/espacio_xxxl"
            android:text="@string/btn_login"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="?attr/temaPrincipal"
            android:textColor="?attr/temaTextoSobrePrincipal"/>

        <!-- REGISTRARSE -->
        <TextView
            android:id="@+id/tvRegistro"
            android:minHeight="@dimen/objetivo_tactil_minimo"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:padding="@dimen/espacio_m"
            android:text="@string/txt_registro"
            android:fontFamily="sans-serif"
            android:textSize="16sp"
            android:textColor="?attr/temaTexto" />

        <TextView
            android:id="@+id/tvAyuda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/objetivo_tactil_minimo"
            android:gravity="center"
            android:padding="@dimen/espacio_m"
            android:text="@string/txt_ayuda_login"
            android:fontFamily="sans-serif"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/temaTexto" />

    </LinearLayout>
</ScrollView>