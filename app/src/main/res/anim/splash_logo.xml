<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true"
    android:interpolator="@android:anim/decelerate_interpolator"
    android:shareInterpolator="true">

    <alpha
        android:duration="@integer/duracion_splash_entrada"
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />

    <scale
        android:duration="@integer/duracion_splash_entrada"
        android:fromXScale="0.5"
        android:fromYScale="0.5"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />

    <scale
        android:duration="@integer/duracion_splash_latido"
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="@integer/duracion_splash_entrada"
        android:toXScale="1.08"
        android:toYScale="1.08" />

    <scale
        android:duration="@integer/duracion_splash_latido"
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="@integer/inicio_splash_vuelta"
        android:toXScale="0.926"
        android:toYScale="0.926" />
</set>
