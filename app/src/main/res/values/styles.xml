<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos reutilizables de la app -->
<resources>

    <!-- Título grande de cada pantalla -->
    <style name="TextoTituloPantalla">
        <item name="android:fontFamily">@font/nunito_extralight</item>
        <item name="android:textColor">@color/azulnoche</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Subtítulo / encabezado de sección -->
    <style name="TextoSeccion">
        <item name="android:fontFamily">@font/nunito_extralight</item>
        <item name="android:textColor">@color/azulnoche</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Texto normal -->
    <style name="TextoCuerpo">
        <item name="android:fontFamily">@font/nunito_extralight</item>
        <item name="android:textColor">@color/azulnoche</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Campo de texto con borde redondeado -->
    <style name="CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/campo_fondo</item>
        <item name="boxStrokeColor">@color/morado</item>
        <item name="hintTextColor">@color/azulnoche</item>
        <item name="android:textColorHint">@color/azulnoche</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!-- Botón principal morado -->
    <style name="BotonPrincipal" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/nunito_extralight</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/morado</item>
    </style>

    <!-- Botón secundario con borde -->
    <style name="BotonSecundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/nunito_extralight</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/azulnoche</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="strokeColor">@color/morado</item>
    </style>

</resources>
