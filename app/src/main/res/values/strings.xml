    <string name="ayuda_titulo">Ayuda</string>
    <string name="ayuda_intro">Te damos la bienvenida a tu colección de cartas MLP. Así funciona la app:</string>
    <string name="ayuda_paso1_titulo">1. Tu colección</string>
    <string name="ayuda_paso1_texto">En Home ves todas las cartas de la edición. Las que tienes aparecen marcadas con ✔ y las que te faltan con ✖.</string>
    <string name="ayuda_paso2_titulo">2. Buscar y filtrar</string>
    <string name="ayuda_paso2_texto">Escribe un nombre o un código en el buscador, o usa los desplegables para filtrar por rareza o por las cartas que tienes.</string>
    <string name="ayuda_paso3_titulo">3. Escanear una carta</string>
    <string name="ayuda_paso3_texto">Pulsa el icono de la cámara en la barra inferior y apunta al código de la carta para añadirla a tu colección.</string>
    <string name="ayuda_paso4_titulo">4. Editar y repetidas</string>
    <string name="ayuda_paso4_texto">Toca una carta para ver su detalle, marcarla como conseguida, sumar repetidas o modificar sus datos.</string>
    <string name="ayuda_paso5_titulo">5. Ajustes</string>
    <string name="ayuda_paso5_texto">En Ajustes puedes cambiar el modo oscuro, el idioma y las opciones del escáner.</string>
