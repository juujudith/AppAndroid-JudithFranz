<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_degradado"
    android:orientation="horizontal">

    <include
        android:id="@+id/bottomBar"
        layout="@layout/barra_inferior" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barraSuperior"
            style="@style/BarraSuperior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/menu_home"
            app:title="@string/home_titulo"
            app:titleCentered="false" />

        <LinearLayout
            android:id="@+id/cuadroContenedorCartas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/espacio_xl"
            android:layout_marginBottom="@dimen/espacio_xs"
            android:background="@drawable/bg_cuadro_cartas"
            android:elevation="@dimen/elevacion_cuadro"
            android:orientation="vertical"
            android:padding="@dimen/espacio_m">

            <LinearLayout
                android:id="@+id/layoutFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/espacio_xs">

                <EditText
                    android:id="@+id/etFiltroCodigo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:minHeight="@dimen/objetivo_tactil_minimo"
                    android:background="@drawable/bg_filtro_input"
                    android:fontFamily="sans-serif"
                    android:hint="@string/hint_buscar"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingHorizontal="@dimen/espacio_lx"
                    android:textColor="?attr/temaTexto"
                    android:textColorHint="?attr/temaTextoSecundario"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnBuscarFiltro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:minWidth="@dimen/objetivo_tactil_minimo"
                    android:minHeight="@dimen/objetivo_tactil_minimo"
                    android:background="@drawable/bg_filtro_input"
                    android:contentDescription="@string/desc_buscar"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="?attr/temaTexto" />

                <Spinner
                    android:id="@+id/spinnerFiltroRareza"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filtro_input"
                    android:contentDescription="@string/desc_filtro_rareza"
                    android:entries="@array/filtro_rareza"
                    android:minHeight="@dimen/objetivo_tactil_minimo"
                    android:paddingHorizontal="@dimen/espacio_m" />

                <Spinner
                    android:id="@+id/spinnerFiltroTengo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filtro_input"
                    android:contentDescription="@string/desc_filtro_tengo"
                    android:entries="@array/filtro_tengo"
                    android:minHeight="@dimen/objetivo_tactil_minimo"
                    android:paddingHorizontal="@dimen/espacio_m" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCartas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:scrollbars="vertical"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="@integer/columnas_cartas"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_carta" />

                <TextView
                    android:id="@+id/tvHomeVacio"
                    style="@style/TextoCuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:padding="@dimen/espacio_m"
                    android:text="@string/home_vacio"
                    android:textColor="?attr/temaTexto"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
